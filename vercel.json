{
  "version": 2,
  "framework": null,
  "installCommand": "npm install -g pnpm@10.26.1 && pnpm install",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/api-spec run codegen && pnpm --filter @workspace/townsend run build",
  "outputDirectory": "artifacts/townsend/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
